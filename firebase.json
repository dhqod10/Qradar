{
  "hosting": {
    "public": "landing",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "order-app-5957e",
          "appId": "1:835847199015:android:1b45f24b099287e8327102",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "order-app-5957e",
          "appId": "1:835847199015:ios:7beb72e4c7d16d8f327102",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "order-app-5957e",
          "configurations": {
            "android": "1:835847199015:android:1b45f24b099287e8327102",
            "ios": "1:835847199015:ios:7beb72e4c7d16d8f327102"
          }
        }
      }
    }
  },
  "emulators": {
    "firestore": {
      "port": 8137
    },
    "functions": {
      "port": 5137
    },
    "ui": {
      "enabled": false
    }
  }
}
