{
  "_doc": "applyOverrideForCustomer 교차 골든 — Dart(lib/core/utils/store_menu_visibility.dart) 와 TS(functions/src/menuVisibility.ts) 가 같은 파일을 읽어 단언한다. 한쪽만 바뀌면 깨져 대조가 강제된다 (spec payment_server_authority §7.1). 핵심 필드(excluded/priceOverride)는 override.status==approved 일 때만, 운영 필드(soldOut/disabledOption*)는 status 무관 즉시 적용. override 의 status 키 부재 = 'pending' (MenuOverrideModel 기본값), 알 수 없는 문자열 = 'approved' (EntityApprovalStatus.fromString 의 legacy 폴백 — 의도적으로 Dart 와 동일하게 고정한다). override 의 excluded/soldOut 부재 = false. expect=null 은 '이 매장은 이 메뉴를 팔지 않는다'.",
  "cases": [
    { "name": "1 override 없음 = 마스터 그대로",
      "master": { "basePrice": 4000, "soldOut": false }, "override": null,
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "2 approved + excluded = null",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "approved", "excluded": true },
      "expect": null },
    { "name": "3 pending + excluded = 마스터 그대로 (excluded 미적용)",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "pending", "excluded": true },
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "4 approved + priceOverride = 가격 3000",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "approved", "priceOverride": 3000 },
      "expect": { "basePrice": 3000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "5 pending + priceOverride = 마스터 가격",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "pending", "priceOverride": 3000 },
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "6 pending + soldOut = 품절 (status 무관)",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "pending", "soldOut": true },
      "expect": { "basePrice": 4000, "soldOut": true, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "7 approved + soldOut:false + 마스터 soldOut:true = 품절 아님 (override 가 이긴다)",
      "master": { "basePrice": 4000, "soldOut": true }, "override": { "status": "approved", "soldOut": false },
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "8 pending + disabledOptionGroupIds = 적용됨 (운영 필드)",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "pending", "disabledOptionGroupIds": ["g1"], "disabledOptionItemIds": ["i1"] },
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": ["g1"], "disabledOptionItemIds": ["i1"] } },
    { "name": "9 rejected + excluded = 마스터 그대로 (approved 아님)",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "rejected", "excluded": true },
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "10 rejected + priceOverride + soldOut = 가격 미적용, 품절 적용",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "rejected", "priceOverride": 3000, "soldOut": true },
      "expect": { "basePrice": 4000, "soldOut": true, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "11 status 키 부재 = pending: excluded 미적용",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "excluded": true },
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "12 status 알 수 없는 문자열 = approved (Dart fromString 폴백 동일): excluded 적용",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "weird", "excluded": true },
      "expect": null },
    { "name": "13 approved + priceOverride 부재 = 마스터 가격",
      "master": { "basePrice": 4000, "soldOut": false }, "override": { "status": "approved" },
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } },
    { "name": "14 override 문서가 있고 soldOut 키 부재 + 마스터 soldOut:true = 품절 아님 (부재 = false 로 덮는다)",
      "master": { "basePrice": 4000, "soldOut": true }, "override": { "status": "approved" },
      "expect": { "basePrice": 4000, "soldOut": false, "disabledOptionGroupIds": [], "disabledOptionItemIds": [] } }
  ]
}
