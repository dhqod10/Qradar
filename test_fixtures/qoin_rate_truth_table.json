{
  "_doc": "Qoin 적립률 진리표 — Dart(test/domain/qoin_rate_resolution_test.dart)와 TS(functions/test/qoinRate.test.mjs)가 같은 파일을 읽는다. 셀 표기: \"absent\"=필드 부재, 숫자=number, \"nan\"=NaN, \"str:3\"=문자열, \"null\"=null. spec §6 의 10행이 resolve R01~R10.",
  "resolve": [
    { "id": "R01", "store": "absent", "brand": "absent", "global": 0.03, "expect": { "rate": 0.03, "source": "global" } },
    { "id": "R02", "store": "absent", "brand": 0.05, "global": 0.03, "expect": { "rate": 0.05, "source": "brand" } },
    { "id": "R03", "store": 0.1, "brand": 0.05, "global": 0.03, "expect": { "rate": 0.1, "source": "store" } },
    { "id": "R04", "store": 0, "brand": 0.05, "global": 0.03, "expect": { "rate": 0, "source": "store" } },
    { "id": "R05", "store": "absent", "brand": 0, "global": 0.03, "expect": { "rate": 0, "source": "brand" } },
    { "id": "R06", "store": 0.1, "brand": 0, "global": 0.03, "expect": { "rate": 0.1, "source": "store" } },
    { "id": "R07", "store": "absent", "brand": "absent", "global": "absent", "expect": { "invalid": "global" } },
    { "id": "R08", "store": 0.5, "brand": 0.05, "global": 0.03, "expect": { "invalid": "store" } },
    { "id": "R09", "store": "absent", "brand": 0.5, "global": 0.03, "expect": { "invalid": "brand" } },
    { "id": "R10", "store": "absent", "brand": "absent", "global": 0.5, "expect": { "invalid": "global" } },
    { "id": "R11", "store": "nan", "brand": 0.05, "global": 0.03, "expect": { "invalid": "store" } },
    { "id": "R12", "store": "str:3", "brand": 0.05, "global": 0.03, "expect": { "invalid": "store" } },
    { "id": "R13", "store": "null", "brand": 0.05, "global": 0.03, "expect": { "invalid": "store" } },
    { "id": "R14", "store": -0.01, "brand": 0.05, "global": 0.03, "expect": { "invalid": "store" } },
    { "id": "R15", "store": 0.0005, "brand": "absent", "global": 0.03, "expect": { "invalid": "store" } },
    { "id": "R16", "store": "absent", "brand": "absent", "global": 0, "expect": { "invalid": "global" } },
    { "id": "R17", "store": 0.001, "brand": "absent", "global": 0.03, "expect": { "rate": 0.001, "source": "store" } },
    { "id": "R18", "store": 0.2, "brand": "absent", "global": 0.03, "expect": { "rate": 0.2, "source": "store" } },
    { "id": "R19", "store": 0.2001, "brand": "absent", "global": 0.03, "expect": { "invalid": "store" } },
    { "id": "R20", "store": "absent", "brand": "absent", "global": 0.03, "note": "브랜드 미소속 개인 매장 (brand 단계 생략)", "expect": { "rate": 0.03, "source": "global" } }
  ],
  "classify": [
    { "raw": "absent", "allowZero": true, "expect": "absent" },
    { "raw": 0.001, "allowZero": true, "expect": "valid" },
    { "raw": 0.0009, "allowZero": true, "expect": "invalid" },
    { "raw": 0.2, "allowZero": true, "expect": "valid" },
    { "raw": 0.2001, "allowZero": true, "expect": "invalid" },
    { "raw": 0.03, "allowZero": true, "expect": "valid" },
    { "raw": 0, "allowZero": true, "expect": "zero" },
    { "raw": 0, "allowZero": false, "expect": "invalid" },
    { "raw": -1, "allowZero": true, "expect": "invalid" },
    { "raw": 1, "allowZero": true, "expect": "invalid" },
    { "raw": 0.5, "allowZero": true, "expect": "invalid" },
    { "raw": "nan", "allowZero": true, "expect": "invalid" },
    { "raw": "str:3", "allowZero": true, "expect": "invalid" },
    { "raw": "null", "allowZero": true, "expect": "invalid" }
  ],
  "callable": [
    { "raw": 0.03, "allowZero": true, "expect": true },
    { "raw": 0.001, "allowZero": true, "expect": true },
    { "raw": 0.2, "allowZero": true, "expect": true },
    { "raw": 0.025, "allowZero": true, "expect": true },
    { "raw": 0.0305, "allowZero": true, "expect": false },
    { "raw": 0, "allowZero": true, "expect": true },
    { "raw": 0, "allowZero": false, "expect": false },
    { "raw": 0.5, "allowZero": true, "expect": false },
    { "raw": 0.0005, "allowZero": true, "expect": false },
    { "raw": -1, "allowZero": true, "expect": false },
    { "raw": "str:3", "allowZero": true, "expect": false },
    { "raw": "nan", "allowZero": true, "expect": false },
    { "raw": "null", "allowZero": true, "expect": false }
  ]
}
