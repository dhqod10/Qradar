{
  "_doc": "카트 금액 산술 교차 골든 — Dart(lib/core/utils/cart_pricing.dart computeCartAmount) 와 TS(functions/src/cartPricing.ts) 가 같은 파일을 읽어 단언한다 (payment_price_authority spec §19-1). 각 라인의 기준가(basePrice)는 menu 문서에서 기존 판정 함수(Dart classifyCheckoutMenu→applyOverrideForCustomer / TS classifyCartMenu)로 얻는다 — 즉 '승인된 priceOverride 만 적용' 분기는 이 산술이 아니라 기존 판정이 결정하고, 이 골든은 그 결과가 산술까지 같은 값으로 이어짐을 고정한다. deltas 는 validateSelection 이 돌려주는 선택 항목의 가격 증감(음수 정상). 식: unit = base + Σ deltas, total = unit × quantity, subtotal = Σ total, expected = subtotal − 0.",
  "cases": [
    { "name": "P1 옵션 없음 단일 라인",
      "lines": [ { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 4000 }, "master": null, "override": null }, "deltas": [], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 4000, "total": 4000 } ], "subtotal": 4000, "expected": 4000 } },
    { "name": "P2 단일 옵션 +500",
      "lines": [ { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 4000 }, "master": null, "override": null }, "deltas": [ 500 ], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 4500, "total": 4500 } ], "subtotal": 4500, "expected": 4500 } },
    { "name": "P3 다중 옵션 +500 +500 +300",
      "lines": [ { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 4000 }, "master": null, "override": null }, "deltas": [ 500, 500, 300 ], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 5300, "total": 5300 } ], "subtotal": 5300, "expected": 5300 } },
    { "name": "P4 음수 priceDelta (텀블러 -300)",
      "lines": [ { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 4500 }, "master": null, "override": null }, "deltas": [ 500, -300 ], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 4700, "total": 4700 } ], "subtotal": 4700, "expected": 4700 } },
    { "name": "P5 quantity > 1: 단가에 수량을 곱한다",
      "lines": [ { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 4000 }, "master": null, "override": null }, "deltas": [ 500 ], "quantity": 3 } ],
      "expect": { "lines": [ { "unit": 4500, "total": 13500 } ], "subtotal": 13500, "expected": 13500 } },
    { "name": "P6 같은 메뉴를 옵션만 달리해 2줄",
      "lines": [
        { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 4000 }, "master": null, "override": null }, "deltas": [ 500 ], "quantity": 1 },
        { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 4000 }, "master": null, "override": null }, "deltas": [ -300 ], "quantity": 2 } ],
      "expect": { "lines": [ { "unit": 4500, "total": 4500 }, { "unit": 3700, "total": 7400 } ], "subtotal": 11900, "expected": 11900 } },
    { "name": "P7 브랜드 메뉴 + approved priceOverride 3000 + 옵션 +500",
      "lines": [ { "menu": { "hasBrand": true, "storeMenu": null, "master": { "basePrice": 4000 }, "override": { "status": "approved", "priceOverride": 3000 } }, "deltas": [ 500 ], "quantity": 2 } ],
      "expect": { "lines": [ { "unit": 3500, "total": 7000 } ], "subtotal": 7000, "expected": 7000 } },
    { "name": "P8 브랜드 메뉴 + pending priceOverride = 마스터 가격 (승인 전 가격은 적용되지 않는다)",
      "lines": [ { "menu": { "hasBrand": true, "storeMenu": null, "master": { "basePrice": 4000 }, "override": { "status": "pending", "priceOverride": 1 } }, "deltas": [], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 4000, "total": 4000 } ], "subtotal": 4000, "expected": 4000 } },
    { "name": "P9 브랜드 메뉴 + rejected priceOverride = 마스터 가격",
      "lines": [ { "menu": { "hasBrand": true, "storeMenu": null, "master": { "basePrice": 4000 }, "override": { "status": "rejected", "priceOverride": 1 } }, "deltas": [ 500 ], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 4500, "total": 4500 } ], "subtotal": 4500, "expected": 4500 } },
    { "name": "P10 브랜드 메뉴 + override 없음 = 마스터 가격",
      "lines": [ { "menu": { "hasBrand": true, "storeMenu": null, "master": { "basePrice": 5200 }, "override": null }, "deltas": [], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 5200, "total": 5200 } ], "subtotal": 5200, "expected": 5200 } },
    { "name": "P11 매장 직영(점포) 메뉴는 master 가 있어도 storeMenu 가 먼저",
      "lines": [ { "menu": { "hasBrand": true, "storeMenu": { "basePrice": 3500 }, "master": { "basePrice": 9999 }, "override": { "status": "approved", "priceOverride": 1 } }, "deltas": [], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 3500, "total": 3500 } ], "subtotal": 3500, "expected": 3500 } },
    { "name": "P12 0원 메뉴 (옵션 없음 / 옵션 +500)",
      "lines": [
        { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 0 }, "master": null, "override": null }, "deltas": [], "quantity": 1 },
        { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 0 }, "master": null, "override": null }, "deltas": [ 500 ], "quantity": 2 } ],
      "expect": { "lines": [ { "unit": 0, "total": 0 }, { "unit": 500, "total": 1000 } ], "subtotal": 1000, "expected": 1000 } },
    { "name": "P13 서로 다른 두 메뉴 합산",
      "lines": [
        { "menu": { "hasBrand": true, "storeMenu": null, "master": { "basePrice": 4000 }, "override": { "status": "approved", "priceOverride": 3500 } }, "deltas": [ 500 ], "quantity": 1 },
        { "menu": { "hasBrand": true, "storeMenu": { "basePrice": 6000 }, "master": null, "override": null }, "deltas": [ -300 ], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 4000, "total": 4000 }, { "unit": 5700, "total": 5700 } ], "subtotal": 9700, "expected": 9700 } },
    { "name": "P14 기준가 부재 / 소수는 0 쪽 버림 (문서 해석)",
      "lines": [
        { "menu": { "hasBrand": false, "storeMenu": { }, "master": null, "override": null }, "deltas": [ 500 ], "quantity": 1 },
        { "menu": { "hasBrand": false, "storeMenu": { "basePrice": 4000.9 }, "master": null, "override": null }, "deltas": [], "quantity": 1 } ],
      "expect": { "lines": [ { "unit": 500, "total": 500 }, { "unit": 4000, "total": 4000 } ], "subtotal": 4500, "expected": 4500 } }
  ]
}
