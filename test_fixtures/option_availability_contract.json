{
  "_doc": "옵션 선택 가능 판정 교차 골든 — Dart(lib/core/utils/option_availability.dart) 와 TS(functions/src/optionPricing.ts) 가 같은 파일을 읽어 단언한다 (payment_price_authority spec §19-1). 한쪽만 바뀌면 깨져 대조가 강제된다. 그룹 문서 값 해석(active 부재=true, selectionType 모르는 값=single, required 부재=false, priceDelta 는 (num)?.toInt() 즉 0 쪽 버림·부재=0, items 의 비-객체 요소는 건너뜀)도 이 파일이 고정한다. kind=resolve : resolveSelectableOptions(고객에게 보이는 그룹·항목). kind=validate : validateSelection(카트 선택의 유효성 + 가격 증감 목록). 항목 비활성 키는 composite '{groupId}_{itemId}' 이며 항목 id 단독은 매칭되지 않는다. validate 의 groups 키는 '{scope}:{id}' 이고 값이 null 이거나 키가 없으면 문서 부재(유령 ref). issues 순서는 선택 순서대로 먼저, 그다음 refs 순서의 그룹 단위 위반(requiredEmpty/multiInSingle).",
  "cases": [
    { "name": "R1 비활성 없음: 그대로",
      "kind": "resolve",
      "groups": [ { "id": "g1", "doc": { "selectionType": "single", "required": true, "items": [ { "id": "a", "label": "A", "priceDelta": 0 }, { "id": "b", "label": "B", "priceDelta": 500 } ] } } ],
      "disabledGroupIds": [], "disabledItemIds": [],
      "expect": [ { "id": "g1", "selectionType": "single", "required": true, "items": [ { "id": "a", "priceDelta": 0 }, { "id": "b", "priceDelta": 500 } ] } ] },
    { "name": "R2 active=false 그룹은 제외",
      "kind": "resolve",
      "groups": [ { "id": "g1", "doc": { "active": false, "items": [ { "id": "a", "priceDelta": 0 } ] } }, { "id": "g2", "doc": { "items": [ { "id": "a", "priceDelta": 0 } ] } } ],
      "disabledGroupIds": [], "disabledItemIds": [],
      "expect": [ { "id": "g2", "selectionType": "single", "required": false, "items": [ { "id": "a", "priceDelta": 0 } ] } ] },
    { "name": "R3 active 키 부재 = true, 모르는 selectionType = single, required 부재 = false",
      "kind": "resolve",
      "groups": [ { "id": "g1", "doc": { "selectionType": "weird", "items": [] } } ],
      "disabledGroupIds": [], "disabledItemIds": [],
      "expect": [ { "id": "g1", "selectionType": "single", "required": false, "items": [] } ] },
    { "name": "R4 점주가 그룹을 끔 = 통째로 제외 (다른 그룹은 유지)",
      "kind": "resolve",
      "groups": [ { "id": "g1", "doc": { "items": [ { "id": "a", "priceDelta": 0 } ] } }, { "id": "g2", "doc": { "selectionType": "multi", "items": [ { "id": "a", "priceDelta": 100 } ] } } ],
      "disabledGroupIds": [ "g1" ], "disabledItemIds": [],
      "expect": [ { "id": "g2", "selectionType": "multi", "required": false, "items": [ { "id": "a", "priceDelta": 100 } ] } ] },
    { "name": "R5 항목 비활성은 composite g1_a 로만 매칭: g2 의 같은 이름 항목 a 는 남는다",
      "kind": "resolve",
      "groups": [ { "id": "g1", "doc": { "items": [ { "id": "a", "priceDelta": 0 }, { "id": "b", "priceDelta": 0 } ] } }, { "id": "g2", "doc": { "items": [ { "id": "a", "priceDelta": 0 } ] } } ],
      "disabledGroupIds": [], "disabledItemIds": [ "g1_a" ],
      "expect": [ { "id": "g1", "selectionType": "single", "required": false, "items": [ { "id": "b", "priceDelta": 0 } ] }, { "id": "g2", "selectionType": "single", "required": false, "items": [ { "id": "a", "priceDelta": 0 } ] } ] },
    { "name": "R6 항목 id 단독('a')은 비활성 키가 아니다 (composite 가 아니므로 아무 것도 지우지 않는다)",
      "kind": "resolve",
      "groups": [ { "id": "g1", "doc": { "items": [ { "id": "a", "priceDelta": 0 } ] } } ],
      "disabledGroupIds": [], "disabledItemIds": [ "a" ],
      "expect": [ { "id": "g1", "selectionType": "single", "required": false, "items": [ { "id": "a", "priceDelta": 0 } ] } ] },
    { "name": "R7 priceDelta 해석: 소수는 0 쪽 버림, 음수 소수도 0 쪽, 부재 = 0, 정수 음수 그대로",
      "kind": "resolve",
      "groups": [ { "id": "g1", "doc": { "selectionType": "multi", "items": [ { "id": "a", "priceDelta": 300.9 }, { "id": "b", "priceDelta": -300.7 }, { "id": "c" }, { "id": "d", "priceDelta": -300 }, { "id": "e", "priceDelta": 0.5 } ] } } ],
      "disabledGroupIds": [], "disabledItemIds": [],
      "expect": [ { "id": "g1", "selectionType": "multi", "required": false, "items": [ { "id": "a", "priceDelta": 300 }, { "id": "b", "priceDelta": -300 }, { "id": "c", "priceDelta": 0 }, { "id": "d", "priceDelta": -300 }, { "id": "e", "priceDelta": 0 } ] } ] },
    { "name": "R8 items 안의 객체가 아닌 요소는 건너뛴다",
      "kind": "resolve",
      "groups": [ { "id": "g1", "doc": { "items": [ 5, "x", null, { "id": "a", "priceDelta": 100 } ] } } ],
      "disabledGroupIds": [], "disabledItemIds": [],
      "expect": [ { "id": "g1", "selectionType": "single", "required": false, "items": [ { "id": "a", "priceDelta": 100 } ] } ] },
    { "name": "V1 유효한 단일 선택: 가격 증감 목록",
      "kind": "validate",
      "refs": [ { "scope": "brand", "id": "g1" } ],
      "groups": { "brand:g1": { "selectionType": "single", "required": true, "items": [ { "id": "a", "priceDelta": 0 }, { "id": "b", "priceDelta": 500 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "b" } ],
      "expect": { "issues": [], "priceDeltas": [ 500 ] } },
    { "name": "V2 ref scope 3종(master/brand/store) 혼합 선택: 선택 순서대로 가격 증감, 음수 포함",
      "kind": "validate",
      "refs": [ { "scope": "master", "id": "g1" }, { "scope": "brand", "id": "g2" }, { "scope": "store", "id": "g3" } ],
      "groups": {
        "master:g1": { "selectionType": "single", "items": [ { "id": "a", "priceDelta": 0 } ] },
        "brand:g2": { "selectionType": "multi", "items": [ { "id": "a", "priceDelta": 500 }, { "id": "b", "priceDelta": 500 } ] },
        "store:g3": { "selectionType": "single", "items": [ { "id": "t", "priceDelta": -300 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g3", "itemId": "t" }, { "groupId": "g2", "itemId": "a" }, { "groupId": "g2", "itemId": "b" } ],
      "expect": { "issues": [], "priceDeltas": [ -300, 500, 500 ] } },
    { "name": "V3 선택하지 않은 optional 그룹은 문제 없음",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "selectionType": "multi", "items": [ { "id": "a", "priceDelta": 500 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [],
      "expect": { "issues": [], "priceDeltas": [] } },
    { "name": "V4 선택한 그룹이 메뉴의 refs 에 없다 = notInRefs",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "items": [ { "id": "a", "priceDelta": 0 } ] }, "store:gX": { "items": [ { "id": "a", "priceDelta": -9000 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "gX", "itemId": "a" } ],
      "expect": { "issues": [ { "groupId": "gX", "itemId": "a", "kind": "notInRefs" } ], "priceDeltas": [] } },
    { "name": "V5 ref 가 가리키는 그룹 문서가 null(유령 ref) = missing",
      "kind": "validate",
      "refs": [ { "scope": "brand", "id": "g1" } ],
      "groups": { "brand:g1": null },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "a" } ],
      "expect": { "issues": [ { "groupId": "g1", "itemId": "a", "kind": "missing" } ], "priceDeltas": [] } },
    { "name": "V6 groups 맵에 키 자체가 없음(brandId 부재로 읽지 못한 brand 그룹 포함) = missing",
      "kind": "validate",
      "refs": [ { "scope": "brand", "id": "g1" } ],
      "groups": {},
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "a" } ],
      "expect": { "issues": [ { "groupId": "g1", "itemId": "a", "kind": "missing" } ], "priceDeltas": [] } },
    { "name": "V7 그룹에 그 항목이 없다 = missing",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "items": [ { "id": "a", "priceDelta": 0 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "zzz" } ],
      "expect": { "issues": [ { "groupId": "g1", "itemId": "zzz", "kind": "missing" } ], "priceDeltas": [] } },
    { "name": "V8 active=false 그룹 선택 = inactive",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "active": false, "items": [ { "id": "a", "priceDelta": 500 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "a" } ],
      "expect": { "issues": [ { "groupId": "g1", "itemId": "a", "kind": "inactive" } ], "priceDeltas": [] } },
    { "name": "V9 점주가 끈 그룹 선택 = disabled",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "items": [ { "id": "a", "priceDelta": 500 } ] } },
      "disabledGroupIds": [ "g1" ], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "a" } ],
      "expect": { "issues": [ { "groupId": "g1", "itemId": "a", "kind": "disabled" } ], "priceDeltas": [] } },
    { "name": "V10 점주가 끈 항목(composite g1_a) 선택 = disabled, 같은 그룹의 다른 항목 b 는 유효",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "selectionType": "multi", "items": [ { "id": "a", "priceDelta": 500 }, { "id": "b", "priceDelta": 200 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [ "g1_a" ],
      "selected": [ { "groupId": "g1", "itemId": "a" }, { "groupId": "g1", "itemId": "b" } ],
      "expect": { "issues": [ { "groupId": "g1", "itemId": "a", "kind": "disabled" } ], "priceDeltas": [ 200 ] } },
    { "name": "V11 required 그룹에 선택이 없다 = requiredEmpty (그룹 단위, itemId 없음)",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "required": true, "items": [ { "id": "a", "priceDelta": 0 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [],
      "expect": { "issues": [ { "groupId": "g1", "kind": "requiredEmpty" } ], "priceDeltas": [] } },
    { "name": "V12 required 그룹을 점주가 끄면 요구하지 않는다 (선택할 수 없는 그룹)",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "required": true, "items": [ { "id": "a", "priceDelta": 0 } ] } },
      "disabledGroupIds": [ "g1" ], "disabledItemIds": [],
      "selected": [],
      "expect": { "issues": [], "priceDeltas": [] } },
    { "name": "V13 required 그룹의 유일한 선택이 끈 항목 = disabled 와 requiredEmpty 둘 다",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "required": true, "items": [ { "id": "a", "priceDelta": 0 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [ "g1_a" ],
      "selected": [ { "groupId": "g1", "itemId": "a" } ],
      "expect": { "issues": [ { "groupId": "g1", "itemId": "a", "kind": "disabled" }, { "groupId": "g1", "kind": "requiredEmpty" } ], "priceDeltas": [] } },
    { "name": "V14 single 그룹에 2개 선택 = multiInSingle",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "selectionType": "single", "items": [ { "id": "a", "priceDelta": 0 }, { "id": "b", "priceDelta": 500 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "a" }, { "groupId": "g1", "itemId": "b" } ],
      "expect": { "issues": [ { "groupId": "g1", "kind": "multiInSingle" } ], "priceDeltas": [ 0, 500 ] } },
    { "name": "V15 multi 그룹은 여러 개 선택 가능",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "selectionType": "multi", "items": [ { "id": "a", "priceDelta": 100 }, { "id": "b", "priceDelta": 200 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "a" }, { "groupId": "g1", "itemId": "b" } ],
      "expect": { "issues": [], "priceDeltas": [ 100, 200 ] } },
    { "name": "V16 같은 (그룹, 항목) 중복 선택 = duplicate (음수 증감 반복으로 가격을 깎는 경로 차단)",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "selectionType": "multi", "items": [ { "id": "t", "priceDelta": -300 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "t" }, { "groupId": "g1", "itemId": "t" }, { "groupId": "g1", "itemId": "t" } ],
      "expect": { "issues": [ { "groupId": "g1", "itemId": "t", "kind": "duplicate" }, { "groupId": "g1", "itemId": "t", "kind": "duplicate" } ], "priceDeltas": [ -300 ] } },
    { "name": "V17 같은 id 의 ref 가 둘이면 첫 ref 가 이긴다 (scope 가 다른 같은 groupId)",
      "kind": "validate",
      "refs": [ { "scope": "master", "id": "g1" }, { "scope": "store", "id": "g1" } ],
      "groups": { "master:g1": { "items": [ { "id": "a", "priceDelta": 100 } ] }, "store:g1": { "items": [ { "id": "a", "priceDelta": 999 } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "a" } ],
      "expect": { "issues": [], "priceDeltas": [ 100 ] } },
    { "name": "V18 priceDelta 해석은 resolve 와 같다 (소수 0 쪽 버림, 부재 0)",
      "kind": "validate",
      "refs": [ { "scope": "store", "id": "g1" } ],
      "groups": { "store:g1": { "selectionType": "multi", "items": [ { "id": "a", "priceDelta": 300.9 }, { "id": "b", "priceDelta": -300.7 }, { "id": "c" } ] } },
      "disabledGroupIds": [], "disabledItemIds": [],
      "selected": [ { "groupId": "g1", "itemId": "a" }, { "groupId": "g1", "itemId": "b" }, { "groupId": "g1", "itemId": "c" } ],
      "expect": { "issues": [], "priceDeltas": [ 300, -300, 0 ] } }
  ]
}
