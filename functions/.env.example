# Toss Payments 서버 시크릿 키
# 실제 값은 Firebase Secrets Manager 로 주입
# 로컬 에뮬레이터 전용 테스트 값 (실제 키 절대 commit 금지)
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxx

# 결제 게이트 모드 (payment_server_authority spec §17.0) — off | shadow | enforce
# 실제 값은 배포 머신의 functions/.env.order-app-5957e (git 제외) 에 한 줄로 둔다. 바꾸면 verifyTossPayment 를 재배포해야 반영된다.
# 값이 없거나 모르는 값(오타·대소문자 포함)이면 off — 게이트를 평가하지 않는다. 절차: docs/tasks/payment_server_authority/implementation.md §8
PAYMENT_GATE_MODE=off

# 결제 금액 게이트 모드 (payment_price_authority spec §8) — off | shadow | enforce. PAYMENT_GATE_MODE 와 독립이다.
# 카트 금액을 Firestore 문서(메뉴·옵션 그룹)에서 다시 계산해 대조한다. off 면 옵션 그룹을 읽지 않는다(비용 0).
# 값이 없거나 모르는 값(오타·대소문자 포함)이면 off. 바꾸면 verifyTossPayment 를 재배포해야 반영된다. 운영 방법: docs/operations.md §6
PAYMENT_PRICE_MODE=off
